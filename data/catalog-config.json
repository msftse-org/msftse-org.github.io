{
  "organization": "msftse-org",
  "includePrivate": false,
  "excludeArchived": true,
  "excludeForks": true,
  "excludedRepositories": [
    ".github",
    "msftse-org.github.io"
  ],
  "defaultCategory": "Product/Application",
  "llmEnrichment": {
    "enabled": true,
    "maxFiles": 8,
    "maxTreeEntries": 400,
    "maxCharactersPerFile": 5000,
    "maxTotalCharacters": 24000,
    "maxTags": 6
  },
  "useCaseByCategory": {
    "POC/Demo": "Field-tested proof of concept",
    "Sample": "Reusable implementation sample",
    "Product/Application": "Production-oriented solution",
    "Workshop": "Hands-on learning experience"
  },
  "categoryRules": [
    {
      "category": "Workshop",
      "topics": ["catalog-workshop", "workshop", "hands-on-lab"],
      "keywords": ["workshop", "hands-on", "training"]
    },
    {
      "category": "Sample",
      "topics": ["catalog-sample", "sample", "samples", "example", "reference-implementation"],
      "keywords": ["sample", "example", "reference implementation", "starter"]
    },
    {
      "category": "POC/Demo",
      "topics": ["catalog-poc-demo", "poc", "proof-of-concept", "demo", "prototype"],
      "keywords": ["poc", "proof of concept", "demo", "prototype"]
    },
    {
      "category": "Product/Application",
      "topics": ["catalog-product", "product", "application", "solution", "platform"],
      "keywords": ["application", "platform", "service"]
    }
  ],
  "overrides": {
    "azure-sre-agent-platform": {
      "include": true,
      "order": 1,
      "title": "Azure SRE Agent Platform",
      "url": "https://github.com/msftse-org/azure-sre-agent-platform",
      "summary": "An autonomous incident-response platform that turns Microsoft Teams signals into diagnosis, remediation pull requests, validation, and a clear resolution loop.",
      "useCase": "Closed-loop Azure operations",
      "category": "POC/Demo",
      "tags": ["azure", "sre", "ai-agents", "incident-response"],
      "language": "Python",
      "visibility": "Private",
      "accent": "cyan"
    },
    "sql-mcp": {
      "order": 2,
      "title": "SQL MCP",
      "summary": "A reference implementation for exposing Azure SQL to AI agents through MCP, API Management, Data API Builder, and Microsoft Entra authentication.",
      "useCase": "Agent-ready enterprise data",
      "category": "POC/Demo",
      "tags": ["azure-sql", "mcp", "api-management", "entra-id"],
      "language": "Shell",
      "accent": "violet"
    }
  }
}
